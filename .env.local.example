# cp .env.local.example .env.local
#
# ローカル開発用。1Password は不要（本番は .github/deploy.env.tpl 経由で1Passwordから注入）。
# Google OAuth はSupabase側（共通プロジェクト）で設定する。開発用クライアントの
# 承認済みリダイレクトURI: http://localhost:3000/auth/callback

DATABASE_URL=mysql://meisai_lab:devpassword@127.0.0.1:3306/app_meisai_lab_dev

# ログイン通知（任意。未設定なら通知しない。ローカルでは空のままでよい）
SIGNALY_LOGIN_WEBHOOK_URL=

# Supabase Auth（Google認証）。開発用Supabaseプロジェクトの値を直接記載する（1Password不要）。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
